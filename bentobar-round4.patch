+    /** WCAG relative luminance of an ARGB color. */
+    fun luminance(argb: Int): Float {
+        fun lin(x: Int): Float { val s = x / 255f; return if (s <= 0.03928f) s / 12.92f else Math.pow(((s + 0.055f) / 1.055f).toDouble(), 2.4).toFloat() }
